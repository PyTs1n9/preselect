# Codex SDK runtime. Auth normally comes from `codex login`; LLM_API_KEY is only
# required when LLM_BASE_URL points at a self-hosted gateway.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
VISION_PROVIDER=openai_codex
VISION_WIRE_API=responses
VISION_TIMEOUT_S=
VISION_MAX_RETRIES=
VISION_DPI=
VISION_EFFORT=
PIPELINE_MAX_REPAIR_ATTEMPTS=
PIPELINE_KEEP_INTERMEDIATE=
PIPELINE_BODY_MIN_HAN=
PIPELINE_BODY_MAX_HAN=
PATHS_RESULT_DIR=
PATHS_PROMPTS_DIR=
PATHS_SKILLS_DIR=
PATHS_FIXTURES_DIR=
