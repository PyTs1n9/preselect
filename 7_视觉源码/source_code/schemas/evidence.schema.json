{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "schema_version": "1.0.2",
  "title": "Evidence facts",
  "description": "B1 字段定义的落盘版本。1.0.2 移除 page_number 的 uniqueItems：一条事实引用同一页的多个块时，页码数组必然是 [1, 1]，它与本字段自述的“与 block_id 按索引对应”冲突；长度一致性改由 validate.py 检查。1.0.1 仅为 strict structured output 兼容而调整：可选字段改为 required + null、oneOf 改为 anyOf。",
  "type": "object",
  "required": ["material_id", "facts"],
  "properties": {
    "material_id": {
      "description": "材料身份，必须与正文首行注释及 manifest 一致；A14 的串稿检测依据此字段。",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "facts": {
      "description": "事实集合。引用编号 [F001] 指向这里的 fact_id，不允许跳号。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fact_id", "core", "page_number", "block_id", "quote", "value", "value_text", "unit", "region"],
        "properties": {
          "fact_id": {
            "description": "稳定标识，形如 F001；单份 evidence 内唯一且从 F001 连续。",
            "type": "string",
            "pattern": "^F[0-9]{3,}$"
          },
          "core": {
            "description": "核心事实标记，由 B 逐条显式填写；核心事实必须至少被正文引用一次。",
            "type": "boolean"
          },
          "page_number": {
            "description": "定位页码数组，跨页按源顺序；与 block_id 按索引对应。同一页的多个块会产生重复页码，故不设 uniqueItems。",
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1}
          },
          "block_id": {
            "description": "定位块号数组，元素指向 document_ir.blocks 中的 block_id。",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "region": {
            "description": "页内区域数组，按 page_number 顺序；无法定位时为 null。",
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x0", "y0", "x1", "y1"],
              "properties": {
                "x0": {"type": "number", "minimum": 0, "maximum": 1},
                "y0": {"type": "number", "minimum": 0, "maximum": 1},
                "x1": {"type": "number", "minimum": 0, "maximum": 1},
                "y1": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          },
          "quote": {
            "description": "原文摘录，必须逐字来自页面文本。",
            "type": "string",
            "minLength": 1
          },
          "value": {
            "description": "数值：单值 number、多值 number 数组、区间 {min,max}，无数字事实为 null。",
            "anyOf": [
              {"type": "number"},
              {"type": "array", "minItems": 1, "items": {"type": "number"}},
              {
                "type": "object",
                "required": ["min", "max"],
                "properties": {"min": {"type": "number"}, "max": {"type": "number"}},
                "additionalProperties": false
              },
              {"type": "null"}
            ]
          },
          "value_text": {
            "description": "原文中的数值表述，保留 80–90%、3 组 等原始写法；无数值表述时为 null。",
            "type": ["string", "null"]
          },
          "unit": {
            "description": "单位：单值字符串、与多值对应的字符串数组，无单位为 null；复合单位完整保留。",
            "anyOf": [
              {"type": "string"},
              {"type": "array", "minItems": 1, "items": {"type": "string"}},
              {"type": "null"}
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
