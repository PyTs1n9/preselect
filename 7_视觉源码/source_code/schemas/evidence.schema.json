{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "schema_version": "1.0.0",
  "title": "Evidence facts",
  "description": "B1 字段定义的落盘版本：顶层 facts 数组、连续 fact_id、显式 core，位置字段数组化。字段名与约束原样取自 B 的答复，A 未增删。",
  "type": "object",
  "required": ["material_id", "facts"],
  "properties": {
    "material_id": {
      "description": "材料身份，必须与正文首行注释及 manifest 一致；A14 的串稿检测依据此字段。",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "facts": {
      "description": "事实集合。引用编号 [F001] 指向这里的 fact_id，不允许跳号。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fact_id", "core", "page_number", "block_id", "quote", "value", "unit"],
        "properties": {
          "fact_id": {
            "description": "稳定标识，形如 F001；单份 evidence 内唯一且从 F001 连续。",
            "type": "string",
            "pattern": "^F[0-9]{3,}$"
          },
          "core": {
            "description": "核心事实标记，由 B 逐条显式填写；核心事实必须至少被正文引用一次。",
            "type": "boolean"
          },
          "page_number": {
            "description": "定位页码数组，跨页按源顺序；与 block_id 按索引对应。",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "block_id": {
            "description": "定位块号数组，元素指向 document_ir.blocks 中的 block_id。",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "region": {
            "description": "页内区域，按页顺序可选填写。",
            "type": "array",
            "items": {"type": "object"}
          },
          "quote": {
            "description": "原文摘录，必须逐字来自页面文本。",
            "type": "string",
            "minLength": 1
          },
          "value": {
            "description": "数值：单值 number、多值 number 数组、区间 {min,max}，无数字事实为 null。",
            "oneOf": [
              {"type": "number"},
              {"type": "array", "minItems": 1, "items": {"type": "number"}},
              {
                "type": "object",
                "required": ["min", "max"],
                "properties": {"min": {"type": "number"}, "max": {"type": "number"}},
                "additionalProperties": false
              },
              {"type": "null"}
            ]
          },
          "value_text": {
            "description": "原文中的数值表述，保留 80–90%、3 组 等原始写法。",
            "type": "string"
          },
          "unit": {
            "description": "单位：单值字符串、与多值对应的字符串数组，无单位为 null；复合单位完整保留。",
            "oneOf": [
              {"type": "string"},
              {"type": "array", "minItems": 1, "items": {"type": "string"}},
              {"type": "null"}
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
