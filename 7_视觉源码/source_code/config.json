    "keep_intermediate": true,
    "body_min_han": 2500,
    "body_max_han": 4000
  },
  "paths": {
    "result_dir": "result/runs",
    "prompts_dir": "prompts",
    "skills_dir": "skills",
    "fixtures_dir": "fixtures/quality"
  }
}
