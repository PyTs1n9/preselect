{
  "version": 2,
  "vision": {
    "provider": "openai_codex",
    "model": "mimo-v2.6-pro",
    "base_url": "https://token-plan-cn.xiaomimimo.com/v1",
    "wire_api": "responses",
    "timeout_s": 120,
    "max_retries": 2,
    "dpi": 200,
    "effort": "medium"
  },
  "pipeline": {
